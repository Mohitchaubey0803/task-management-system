@model List<TaskManagementSystem.Models.TaskItem>
@{
    ViewData["Title"] = "Tasks";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Task List</h3>
    <a asp-action="Create" class="btn btn-primary">
        ➕ New Task
    </a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="search"
               value="@Context.Request.Query["search"]"
               class="form-control"
               placeholder="Search by title" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-secondary w-100">Search</button>
    </div>
</form>

<table class="table table-bordered table-hover bg-white">
    <thead class="table-light">
        <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Due Date</th>
            <th>Created</th>
            <th style="width:200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>
                    <span class="badge
                        @(task.Status == TaskManagementSystem.Models.TaskStatus.Completed ? "bg-success" :
                                                task.Status == TaskManagementSystem.Models.TaskStatus.InProgress ? "bg-warning text-dark" :
                                                "bg-secondary")">
                        @task.Status
                    </span>
                </td>
                <td>@task.DueDate.ToShortDateString()</td>
                <td>@task.CreatedOn.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-info">View</a>
                    <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
